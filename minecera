#!/usr/bin/env bash
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTROL="$ROOT/run/control"
SUPERVISOR_LOG="$ROOT/logs/supervisor.log"
LOG_LINES=12
RUNNING=1
INPUT=""
LAST_RENDER=0

cleanup() {
    stty sane 2>/dev/null || true
    printf '\033[?25h\033[0m\n'
}
trap cleanup EXIT INT TERM

is_running() {
    [ -p "$CONTROL" ]
}

server_pid() {
    pgrep -f '^java .*paper-26\.2\.jar' | head -n1
}

server_log() {
    ls -1t "$ROOT"/logs/server-*.log 2>/dev/null | head -n1
}

backup_count() {
    find "$ROOT/backups" -mindepth 2 -maxdepth 2 -type f -name HEALTHY 2>/dev/null | wc -l
}

latest_backup() {
    find "$ROOT/backups" -mindepth 2 -maxdepth 2 -type f -name HEALTHY -printf '%h\n' 2>/dev/null | sort -r | head -n1 | xargs -r basename
}

value_or_dash() {
    [ -n "$1" ] && printf '%s' "$1" || printf '-'
}

render() {
    local pid log cpu mem uptime load disk backups newest supervisor lines
    local rows cols

    rows=$(tput lines 2>/dev/null || printf '24')
    cols=$(tput cols 2>/dev/null || printf '80')
    pid=$(server_pid)
    log=$(server_log)
    backups=$(backup_count)
    newest=$(latest_backup)
    supervisor=$(tail -n1 "$SUPERVISOR_LOG" 2>/dev/null)
    load=$(awk '{print $1" "$2" "$3}' /proc/loadavg 2>/dev/null)
    disk=$(df -h "$ROOT" 2>/dev/null | awk 'NR==2 {print $3"/"$2" ("$5")"}')

    if [ -n "$pid" ]; then
        cpu=$(ps -p "$pid" -o %cpu= 2>/dev/null | xargs)
        mem=$(ps -p "$pid" -o rss= 2>/dev/null | awk '{printf "%.1fG", $1/1024/1024}')
        uptime=$(ps -p "$pid" -o etime= 2>/dev/null | xargs)
    else
        cpu='-'
        mem='-'
        uptime='-'
    fi

    printf '\033[H\033[2J'
    printf ' Minecera\n'
    printf ' %s\n' '──────────────────────────────────────────────────────────────────────────────'

    if [ -n "$pid" ]; then
        printf ' SERVER   ● RUNNING    PID %-7s   UPTIME %-10s\n' "$pid" "$uptime"
    else
        printf ' SERVER   ○ OFFLINE\n'
    fi
    printf ' MEMORY   %-8s     CPU %-7s      LOAD %-17s\n' "$(value_or_dash "$mem")" "$(value_or_dash "$cpu")" "$(value_or_dash "$load")"
    printf ' DISK     %-18s   BACKUPS %-3s      LAST %-18s\n' "$(value_or_dash "$disk")" "$backups" "$(value_or_dash "$newest")"
    printf ' EVENT    %s\n' "$(value_or_dash "$supervisor")"
    printf ' %s\n' '──────────────────────────────────────────────────────────────────────────────'
    printf ' LOG\n'

    if [ -n "$log" ] && [ -f "$log" ]; then
        tail -n "$LOG_LINES" "$log" | sed "s/\r//g" | cut -c1-$((cols - 1))
    else
        printf ' no Minecraft log yet\n'
    fi

    local used=$((rows - LOG_LINES - 9))
    [ "$used" -lt 1 ] && used=1
    printf '%*s\n' "$used" ''
    printf ' %s' '> '
    printf '%s' "$INPUT"
    printf '\033[?25l'
}

send() {
    local command="$1"
    is_running || return 1
    timeout 1 bash -c 'printf "%s\n" "$1" > "$2"' _ "$command" "$CONTROL" 2>/dev/null
}

run_command() {
    local command="$1"

    [ -n "$command" ] || return

    case "$command" in
        exit|quit)
            RUNNING=0
            return
            ;;
        clear)
            return
            ;;
        help)
            send "help"
            ;;
        *)
            if ! send "$command"; then
                INPUT='supervisor is not running'
                sleep 1
            fi
            ;;
    esac
}

stty -icanon -echo min 0 time 1
printf '\033[?25l'

while [ "$RUNNING" -eq 1 ]; do
    render

    if IFS= read -r -N1 char; then
        case "$char" in
            $'\n'|$'\r')
                command="$INPUT"
                INPUT=""
                run_command "$command"
                ;;
            $'\177'|$'\b')
                INPUT="${INPUT%?}"
                ;;
            $'\003')
                INPUT=""
                ;;
            $'\004')
                RUNNING=0
                ;;
            $'\033')
                IFS= read -r -N2 discard
                ;;
            *)
                INPUT+="$char"
                ;;
        esac
    fi

done

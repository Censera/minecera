#!/usr/bin/env bash
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTROL="$ROOT/run/control"
SERVER_INPUT="$ROOT/run/server.stdin"
LOG_LINES=14
FRAME=0.25
REFRESH=5
RUNNING=1
INPUT=""
MESSAGE=""
LAST_RENDER=0

cleanup() {
    stty sane 2>/dev/null || true
    printf '\033[?25h\033[0m\033[?1049l'
}
trap cleanup EXIT INT TERM

server_pid() {
    pgrep -f '(^|/)java .*paper-26\.2\.jar' | head -n1
}

server_log() {
    ls -1t "$ROOT"/logs/server-*.log 2>/dev/null | head -n1
}

journal_lines() {
    journalctl -u minecera.service -n "$LOG_LINES" -o cat --no-pager 2>/dev/null
}

log_lines() {
    local journal
    journal=$(journal_lines)
    if [ -n "$journal" ]; then
        printf '%s\n' "$journal"
        return
    fi

    local log
    log=$(server_log)
    if [ -n "$log" ] && [ -f "$log" ]; then
        tail -n "$LOG_LINES" "$log"
    else
        printf 'no log available\n'
    fi
}

backup_count() {
    find "$ROOT/backups" -mindepth 2 -maxdepth 2 -type f -name HEALTHY 2>/dev/null | wc -l
}

latest_backup() {
    find "$ROOT/backups" -mindepth 2 -maxdepth 2 -type f -name HEALTHY -printf '%h\n' 2>/dev/null |
        sort -r | head -n1 | xargs -r basename
}

supervisor_event() {
    journalctl -u minecera.service -n 1 -o cat --no-pager 2>/dev/null |
        sed 's/.*bash\[[0-9]*\]: //' | cut -c1-100
}

command_send() {
    printf '%s\n' "$1" > "$CONTROL"
}

minecraft_send() {
    printf '%s\n' "$1" > "$SERVER_INPUT"
}

run_command() {
    local command="$1"
    [ -n "$command" ] || return

    case "$command" in
        exit|quit)
            RUNNING=0
            return
            ;;
        help)
            MESSAGE='status  save  backup  restart  stop  start  reload  clear  exit | anything else = Minecraft'
            ;;
        clear)
            MESSAGE=""
            ;;
        status|backup|restart|stop|start|reload)
            command_send "$command"
            MESSAGE="sent: $command"
            ;;
        save)
            minecraft_send 'save-all flush'
            MESSAGE='sent: save-all flush'
            ;;
        *)
            minecraft_send "$command"
            MESSAGE="sent: $command"
            ;;
    esac
}

render() {
    local rows cols width log pid cpu mem uptime load disk backups newest event
    rows=$(tput lines 2>/dev/null || printf '24')
    cols=$(tput cols 2>/dev/null || printf '80')
    width=$((cols - 2))
    [ "$width" -lt 40 ] && width=40

    pid=$(server_pid)
    backups=$(backup_count)
    newest=$(latest_backup)
    load=$(awk '{printf "%s %s %s", $1, $2, $3}' /proc/loadavg 2>/dev/null)
    disk=$(df -h "$ROOT" 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')
    event=$(supervisor_event)

    if [ -n "$pid" ]; then
        cpu=$(ps -p "$pid" -o %cpu= 2>/dev/null | xargs)
        mem=$(ps -p "$pid" -o rss= 2>/dev/null | awk '{printf "%.1fG", $1/1024/1024}')
        uptime=$(ps -p "$pid" -o etime= 2>/dev/null | xargs)
        printf '\033[?25l\033[H\033[2J'
        printf ' Minecera\n'
        printf ' %s\n' "$(printf '─%.0s' $(seq 1 "$width"))"
        printf ' SERVER    ● RUNNING     PID %-7s  UPTIME %-10s\n' "$pid" "$uptime"
    else
        cpu='-'
        mem='-'
        uptime='-'
        printf '\033[?25l\033[H\033[2J'
        printf ' Minecera\n'
        printf ' %s\n' "$(printf '─%.0s' $(seq 1 "$width"))"
        printf ' SERVER    ○ OFFLINE\n'
    fi

    printf ' MEMORY    %-8s      CPU %-7s       LOAD %-17s\n' "$mem" "$cpu" "$load"
    printf ' DISK      %-18s  BACKUPS %-3s       LAST %-18s\n' "$disk" "$backups" "${newest:--}"
    printf ' EVENT     %-*s\n' "$((width - 9))" "${event:--}"
    printf ' %s\n' "$(printf '─%.0s' $(seq 1 "$width"))"
    printf ' JOURNAL\n'

    log=$(log_lines)
    while IFS= read -r line; do
        printf '%s\n' "$line" | sed 's/\r//g' | cut -c1-$width
    done <<< "$log"

    local used=$((rows - LOG_LINES - 9))
    [ "$used" -lt 1 ] && used=1
    printf '%*s\n' "$used" ''

    printf ' %s\n' "$(printf '─%.0s' $(seq 1 "$width"))"
    [ -n "$MESSAGE" ] && printf ' %s\n' "$MESSAGE"
    printf ' > %s' "$INPUT"
}

stty -icanon -echo min 0 time 1
printf '\033[?1049h\033[?25l'

while [ "$RUNNING" -eq 1 ]; do
    now=$(date +%s)
    if [ $((now - LAST_RENDER)) -ge "$REFRESH" ]; then
        render
        LAST_RENDER=$now
    fi

    if IFS= read -r -N1 -t "$FRAME" char; then
        case "$char" in
            $'\n'|$'\r')
                command="$INPUT"
                INPUT=""
                run_command "$command"
                render
                LAST_RENDER=$(date +%s)
                ;;
            $'\177'|$'\b')
                INPUT="${INPUT%?}"
                ;;
            $'\003')
                INPUT=""
                ;;
            $'\004')
                RUNNING=0
                ;;
            $'\033')
                IFS= read -r -N2 -t 0.01 discard
                ;;
            *)
                INPUT+="$char"
                ;;
        esac
    fi
done
